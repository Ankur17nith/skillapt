{
  "name": "skillapt",
  "version": "0.1.0",
  "description": "Package manager and CLI for AI agent skills",
  "type": "module",
  "bin": {
    "skillapt": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "skillapt",
    "ai",
    "agent",
    "skills",
    "claude",
    "cursor",
    "codex",
    "package-manager",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ankur17nith/skillapt.git"
  },
  "homepage": "https://github.com/Ankur17nith/skillapt#readme",
  "bugs": {
    "url": "https://github.com/Ankur17nith/skillapt/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "install.sh"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.6",
    "tar": "^7.5.22",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
