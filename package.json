{
  "name": "skillpm",
  "version": "0.0.1",
  "description": "A package manager for AI agent skills",
  "type": "module",
  "bin": {
    "skillpm": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agent",
    "skills",
    "package-manager",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/skillpm/skillpm.git"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.6",
    "tar": "^7.5.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@types/tar": "^6.1.13",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
